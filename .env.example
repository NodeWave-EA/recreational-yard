# Recreation Yard Limited - Environment Configuration
# App & Site Configuration
NUXT_PUBLIC_SITE_URL=https://recreational-yard.vercel.app

# Cloudflare Turnstile Captcha Security
# Obtain keys from Cloudflare Dashboard -> Turnstile
# Demo Site Key (Always Passes): 1x00000000000000000000AA
# Demo Secret Key (Always Passes): 1x0000000000000000000000000000000AA
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NUXT_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# SMTP Server Email Configuration (Inquiry Handler)
NUXT_SMTP_HOST=smtp.gmail.com
NUXT_SMTP_PORT=587
NUXT_SMTP_USER=relax@recreationyard.com
NUXT_SMTP_PASS=your_app_password_here
NUXT_SMTP_FROM="Recreation Yard Limited" <relax@recreationyard.com>
NUXT_CONTACT_RECIPIENT=relax@recreationyard.com

# Studio Configuration
STUDIO_GOOGLE_CLIENT_ID=<your_google_client_id>
STUDIO_GOOGLE_CLIENT_SECRET=<your_google_client_secret>
STUDIO_GITHUB_TOKEN=<your_github_personal_access_token>
STUDIO_GOOGLE_MODERATORS=admin@example.com,editor@example.com
